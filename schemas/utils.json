{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://psma.com/sas/utils.json",
    "title": "SAS utils",
    "description": "Shared sub-schemas reused by every SAS per-type document (mosfet, diode, igbt, bjt). Component-specific electricals, modelParams and curves live in the per-type files.",
    "$defs": {
        "part": {
            "description": "Part identification — shared across all semiconductor types. Extends the PEAS datasheetInfoPartBase with semiconductor-specific fields.",
            "allOf": [
                {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/datasheetInfoPartBase"
                },
                {
                    "type": "object",
                    "properties": {
                        "partNumber": {},
                        "series": {},
                        "case": {},
                        "description": {},
                        "technology": {
                            "type": "string",
                            "enum": [
                                "Si",
                                "SiC",
                                "GaN",
                                "GaAs",
                                "Ge"
                            ]
                        },
                        "subType": {
                            "type": "string",
                            "description": "Per-device-type subtype. MOSFET: nChannel/pChannel. Diode: schottky/sicSchottky/ultrafast/fastRecovery/fast/standard/rectifier/zener/tvs/esd. IGBT: nChannel. BJT: npn/pnp."
                        },
                        "package": {
                            "type": "string",
                            "description": "Manufacturer's exact package designation (e.g. Infineon PG-TDSON-8). Complements case, which holds the generic industry code."
                        },
                        "qualification": {
                            "type": "string",
                            "description": "Qualification grade (e.g. Industrial, Automotive (AEC-Q101))."
                        },
                        "matchcodeDescription": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "technology"
                    ]
                }
            ]
        },
        "thermal": {
            "$ref": "https://psma.com/peas/utils.json#/$defs/datasheetInfoThermalSemiconductor"
        },
        "mechanical": {
            "description": "Mechanical specs — extends PEAS datasheetInfoMechanical with a package case field.",
            "allOf": [
                {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/datasheetInfoMechanical"
                },
                {
                    "type": "object",
                    "properties": {
                        "length": {},
                        "width": {},
                        "height": {},
                        "diameter": {},
                        "weight": {},
                        "shapeType": {},
                        "assemblyType": {},
                        "case": {
                            "type": "string",
                            "description": "Package name (TO-220, SOT-23, etc.) — mirrors part.case for convenience."
                        }
                    },
                    "additionalProperties": false
                }
            ]
        }
    }
}
