{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://psma.com/sas/diode.json",
    "title": "diode",
    "description": "Diode (Schottky, ultrafast, SiC Schottky, Zener, TVS, ESD protection) component data. The presence of the 'diode' field at the top level of an SAS document discriminates the device type — there is no deviceType property. part.subType further discriminates zener/esd, which have their own required electrical fields.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "manufacturerInfo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/name"
                },
                "reference": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/reference"
                },
                "status": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/status"
                },
                "description": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/description"
                },
                "orderCode": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/orderCode"
                },
                "datasheetUrl": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/datasheetUrl"
                },
                "spiceModel": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/spiceModel"
                },
                "family": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/family"
                },
                "datasheetInfo": {
                    "$ref": "#/$defs/datasheetInfo"
                }
            },
            "required": [
                "name",
                "datasheetInfo"
            ]
        },
        "distributorsInfo": {
            "description": "Where to buy this component",
            "type": "array",
            "items": {
                "$ref": "https://psma.com/peas/utils.json#/$defs/distributorInfo"
            }
        }
    },
    "required": [
        "manufacturerInfo"
    ],
    "$defs": {
        "datasheetInfo": {
            "description": "All information extracted from the diode datasheet.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "part": {
                    "$ref": "./utils.json#/$defs/part"
                },
                "electrical": {
                    "$ref": "#/$defs/electrical"
                },
                "thermal": {
                    "$ref": "./utils.json#/$defs/thermal"
                },
                "mechanical": {
                    "$ref": "./utils.json#/$defs/mechanical"
                },
                "modelParams": {
                    "$ref": "#/$defs/modelParams"
                },
                "curves": {
                    "$ref": "#/$defs/curves"
                }
            },
            "required": [
                "part",
                "electrical"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "part": {
                                "properties": {
                                    "subType": {
                                        "const": "zener"
                                    }
                                },
                                "required": [
                                    "subType"
                                ]
                            }
                        },
                        "required": [
                            "part"
                        ]
                    },
                    "then": {
                        "properties": {
                            "electrical": {
                                "required": [
                                    "breakdownVoltage",
                                    "powerDissipation"
                                ]
                            }
                        }
                    },
                    "else": {
                        "if": {
                            "properties": {
                                "part": {
                                    "properties": {
                                        "subType": {
                                            "const": "esd"
                                        }
                                    },
                                    "required": [
                                        "subType"
                                    ]
                                }
                            },
                            "required": [
                                "part"
                            ]
                        },
                        "then": {
                            "properties": {
                                "electrical": {
                                    "required": [
                                        "standoffVoltage"
                                    ],
                                    "anyOf": [
                                        {
                                            "required": [
                                                "peakPulseCurrent"
                                            ]
                                        },
                                        {
                                            "required": [
                                                "peakPulsePower"
                                            ]
                                        },
                                        {
                                            "required": [
                                                "esdVoltageContact"
                                            ]
                                        }
                                    ]
                                }
                            }
                        },
                        "else": {
                            "if": {
                                "properties": {
                                    "part": {
                                        "properties": {
                                            "subType": {
                                                "const": "tvs"
                                            }
                                        },
                                        "required": [
                                            "subType"
                                        ]
                                    }
                                },
                                "required": [
                                    "part"
                                ]
                            },
                            "then": {
                                "properties": {
                                    "electrical": {
                                        "required": [
                                            "standoffVoltage",
                                            "clampingVoltage"
                                        ],
                                        "anyOf": [
                                            {
                                                "required": [
                                                    "peakPulseCurrent"
                                                ]
                                            },
                                            {
                                                "required": [
                                                    "peakPulsePower"
                                                ]
                                            }
                                        ]
                                    }
                                }
                            },
                            "else": {
                                "properties": {
                                    "electrical": {
                                        "required": [
                                            "reverseVoltage",
                                            "forwardVoltage",
                                            "forwardCurrent"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "electrical": {
            "description": "Diode electrical characteristics. Required fields depend on part.subType (enforced in datasheetInfo): rectifier-family parts require reverseVoltage + forwardVoltage (V_F, the defining rectifier conduction parameter) + forwardCurrent; zener requires breakdownVoltage (= V_Z) + powerDissipation; esd requires standoffVoltage + at least one pulse rating (peakPulseCurrent, peakPulsePower or esdVoltageContact); tvs requires standoffVoltage + clampingVoltage + at least one pulse rating (peakPulseCurrent or peakPulsePower). TVS and ESD parts do not have a forwardCurrent (I_F(AV)) rating — that is a rectifier parameter; their forward-direction capability, when published, is the surge surgeCurrent (I_FSM).",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "reverseVoltage": {
                    "type": "number",
                    "description": "V_RRM in Volts"
                },
                "forwardCurrent": {
                    "type": "number",
                    "description": "I_F(AV) in Amperes"
                },
                "surgeCurrent": {
                    "type": "number",
                    "description": "I_FSM in Amperes"
                },
                "forwardVoltage": {
                    "type": "number",
                    "description": "V_F in Volts"
                },
                "forwardVoltageAt": {
                    "type": "number",
                    "description": "I_F at which V_F is specified in Amperes"
                },
                "reverseLeakageCurrent": {
                    "type": "number",
                    "description": "I_R in Amperes"
                },
                "reverseRecoveryTime": {
                    "type": "number",
                    "description": "t_rr in seconds"
                },
                "reverseRecoveryCharge": {
                    "type": "number",
                    "description": "Q_rr in Coulombs"
                },
                "junctionCapacitance": {
                    "type": "number",
                    "description": "C_j in Farads"
                },
                "junctionCapacitanceVr": {
                    "type": "number",
                    "description": "V_R for C_j measurement in Volts"
                },
                "powerDissipation": {
                    "type": "number",
                    "description": "P_D max in Watts"
                },
                "clampingVoltage": {
                    "type": "number",
                    "description": "V_C at I_PP for TVS in Volts"
                },
                "breakdownVoltage": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/dimensionWithTolerance",
                    "description": "V_BR for Zener/TVS/ESD in Volts. For zeners this IS the zener voltage V_Z (min/nom/max from the datasheet table, specified at zenerTestCurrent) — there is deliberately no separate zenerVoltage field."
                },
                "zenerTestCurrent": {
                    "type": "number",
                    "description": "I_ZT in Amperes — test current at which V_Z (breakdownVoltage) is specified"
                },
                "zenerImpedance": {
                    "type": "number",
                    "description": "Z_ZT in Ohms — dynamic impedance at I_ZT"
                },
                "standoffVoltage": {
                    "type": "number",
                    "description": "V_RWM working voltage for TVS/ESD in Volts"
                },
                "peakPulseCurrent": {
                    "type": "number",
                    "description": "I_PP for TVS/ESD in Amperes (datasheet-stated waveform, typically 8/20 us or IEC 61000-4-5)"
                },
                "peakPulsePower": {
                    "type": "number",
                    "description": "P_PP for TVS/ESD in Watts (datasheet-stated waveform, e.g. 10/1000 us or 8/20 us)"
                },
                "esdVoltageContact": {
                    "type": "number",
                    "description": "IEC 61000-4-2 contact discharge rating in Volts"
                },
                "esdVoltageAir": {
                    "type": "number",
                    "description": "IEC 61000-4-2 air discharge rating in Volts"
                }
            }
        },
        "modelParams": {
            "description": "SPICE model parameters for diode.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "is": {
                    "type": "number",
                    "description": "Saturation current in Amperes"
                },
                "n": {
                    "type": "number",
                    "description": "Ideality factor"
                },
                "rs": {
                    "type": "number",
                    "description": "Series resistance in Ohms"
                },
                "cj0": {
                    "type": "number",
                    "description": "Zero-bias junction capacitance in Farads"
                },
                "vj": {
                    "type": "number",
                    "description": "Junction potential in Volts"
                },
                "m": {
                    "type": "number",
                    "description": "Grading coefficient"
                },
                "tt": {
                    "type": "number",
                    "description": "Transit time in seconds"
                },
                "bv": {
                    "type": "number",
                    "description": "Breakdown voltage in Volts"
                },
                "ibv": {
                    "type": "number",
                    "description": "Current at breakdown in Amperes"
                }
            }
        },
        "curves": {
            "description": "Diode characteristic curves from datasheet.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "forwardVoltageVsCurrent": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/curve",
                    "description": "V_F vs I_F"
                },
                "forwardVoltageVsTj": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/curve",
                    "description": "V_F vs Tj"
                },
                "reverseCurrentVsVoltage": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/curve",
                    "description": "I_R vs V_R"
                },
                "capacitanceVsVoltage": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/curve",
                    "description": "C_j vs V_R"
                },
                "thermalImpedance": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/curve",
                    "description": "Z_th(j-c) vs pulse width"
                },
                "soa": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/curve",
                    "description": "Safe Operating Area"
                }
            }
        }
    }
}
