{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://psma.com/sas/diode.json",
    "title": "diode",
    "description": "Diode (Schottky, ultrafast, SiC Schottky, Zener, TVS, ESD protection) component data. The presence of the 'diode' field at the top level of an SAS document discriminates the device type — there is no deviceType property. part.subType further discriminates zener/esd, which have their own required electrical fields.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "manufacturerInfo": {
            "title": "diodeManufacturerInfo",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/name"
                },
                "reference": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/reference"
                },
                "status": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/status"
                },
                "description": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/description"
                },
                "orderCode": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/orderCode"
                },
                "datasheetUrl": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/datasheetUrl"
                },
                "spiceModel": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/spiceModel"
                },
                "family": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/family"
                },
                "datasheetInfo": {
                    "$ref": "#/$defs/datasheetInfo"
                }
            },
            "required": [
                "name",
                "datasheetInfo"
            ]
        },
        "distributorsInfo": {
            "description": "Where to buy this component",
            "type": "array",
            "items": {
                "$ref": "https://psma.com/peas/utils.json#/$defs/distributorInfo"
            }
        },
        "substitutesInfo": {
            "description": "Replacement parts for this one: manufacturer-named successors and second sources. An entry with type 'successor' means THIS part is superseded by the named one, one hop, as the manufacturer states it - never inferred from a status of obsolete or from part-number similarity. The schema cannot check that the named part exists in the catalogue, or exists exactly once; that is the referential pass's job, as for CIAS component URIs. Evidence for the claim goes in the record's provenance[] with fields: [\"substitutesInfo\"], carrying the same sourceUrl, retrievedDate and verification stamp as any datasheet field.",
            "type": "array",
            "items": {
                "$ref": "https://psma.com/peas/utils.json#/$defs/substituteInfo"
            }
        },
        "spiceModel": {
            "description": "Device-body SPICE .model card for a simulation-sourced part (no datasheet). Faithful home that does not require manufacturerInfo.",
            "$ref": "./utils.json#/$defs/spiceModel"
        }
    },
    "anyOf": [
        {
            "required": [
                "manufacturerInfo"
            ]
        },
        {
            "required": [
                "spiceModel"
            ]
        },
        {
            "maxProperties": 0
        }
    ],
    "$defs": {
        "datasheetInfo": {
            "title": "diodeDatasheetInfo",
            "description": "All information extracted from the diode datasheet.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "part": {
                    "allOf": [
                        {
                            "$ref": "./utils.json#/$defs/part"
                        },
                        {
                            "$comment": "Device-specific narrowing of the shared part def: subType must come from this closed enum (protects the exact-string conditionals, e.g. diode zener/tvs/esd required sets).",
                            "properties": {
                                "subType": {
                                    "enum": [
                                        "rectifier",
                                        "schottky",
                                        "sicSchottky",
                                        "fastRecovery",
                                        "ultrafast",
                                        "switching",
                                        "pin",
                                        "zener",
                                        "tvs",
                                        "esd"
                                    ]
                                },
                                "dieConfiguration": {
                                    "enum": [
                                        "single",
                                        "dual",
                                        "array"
                                    ],
                                    "description": "'dual' = two diodes in one package (center-tap rectifiers, BAT54C/A/S, BAV99); 'array' = three or more (multi-line ESD / TVS arrays such as Littelfuse AQ7520-08UTG, diode quads). When the diodes are identical the electrical block describes ONE diode, not the package: forwardCurrent, surgeCurrent, forwardVoltage/forwardVoltageAt, reverseLeakageCurrent, junctionCapacitance and powerDissipation are per diode, as datasheets state them 'per leg' / 'per diode' / 'per line', and electrical.numberOfElements states how many there are (required for 'array'). Never divide a package total by the count: record the per-diode figure the datasheet prints, or omit the field. Exception: where the datasheet itself states the per-diode rating as a fixed fraction of the printed package value (e.g. ROHM 'Io/2 per diode'), record that fraction; never infer a fraction when the datasheet is silent. When the diodes DIFFER (different subType or ratings in one package), there is no package electrical block: each is described in dies[]. Absent = single diode."
                                },
                                "internalConnection": {
                                    "enum": [
                                        "independent",
                                        "commonCathode",
                                        "commonAnode",
                                        "series"
                                    ]
                                }
                            }
                        }
                    ]
                },
                "electrical": {
                    "$ref": "#/$defs/electrical"
                },
                "dies": {
                    "description": "One entry per diode in a multi-diode package whose diodes DIFFER (different subType or ratings, e.g. a steering-diode pair plus a different clamp). Present INSTEAD OF the package-level electrical block, never beside it: such a package has no single V_F, V_RWM or I_PP, and leaving a package-level slot open is what lets one diode's numbers be recorded as the part's. A package of identical diodes does NOT use dies[]: it keeps the one electrical block and states electrical.numberOfElements. The count is the length of dies[]. Order carries no meaning; diodes are identified by name.",
                    "type": "array",
                    "minItems": 2,
                    "items": {
                        "$ref": "#/$defs/die"
                    }
                },
                "thermal": {
                    "$ref": "./utils.json#/$defs/thermal"
                },
                "mechanical": {
                    "$ref": "./utils.json#/$defs/mechanical"
                },
                "modelParams": {
                    "$ref": "#/$defs/modelParams"
                },
                "curves": {
                    "$ref": "#/$defs/curves"
                },
                "provenance": {
                    "description": "Data-provenance trail (see provenance).",
                    "$ref": "https://psma.com/peas/utils.json#/$defs/provenance"
                }
            },
            "required": [
                "part"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "part": {
                                "properties": {
                                    "subType": {
                                        "const": "zener"
                                    }
                                },
                                "required": [
                                    "subType"
                                ]
                            }
                        },
                        "required": [
                            "part"
                        ]
                    },
                    "then": {
                        "properties": {
                            "electrical": {
                                "$ref": "#/$defs/zenerElectricalRequired"
                            }
                        }
                    },
                    "else": {
                        "if": {
                            "properties": {
                                "part": {
                                    "properties": {
                                        "subType": {
                                            "const": "esd"
                                        }
                                    },
                                    "required": [
                                        "subType"
                                    ]
                                }
                            },
                            "required": [
                                "part"
                            ]
                        },
                        "then": {
                            "properties": {
                                "electrical": {
                                    "$ref": "#/$defs/esdElectricalRequired"
                                }
                            }
                        },
                        "else": {
                            "if": {
                                "properties": {
                                    "part": {
                                        "properties": {
                                            "subType": {
                                                "const": "tvs"
                                            }
                                        },
                                        "required": [
                                            "subType"
                                        ]
                                    }
                                },
                                "required": [
                                    "part"
                                ]
                            },
                            "then": {
                                "properties": {
                                    "electrical": {
                                        "$ref": "#/$defs/tvsElectricalRequired"
                                    }
                                }
                            },
                            "else": {
                                "properties": {
                                    "electrical": {
                                        "$ref": "#/$defs/rectifierElectricalRequired"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "$comment": "dies[] is the multi-diode shape: a part described per diode must declare dual or array.",
                    "if": {
                        "required": [
                            "dies"
                        ]
                    },
                    "then": {
                        "required": [
                            "part"
                        ],
                        "properties": {
                            "part": {
                                "required": [
                                    "dieConfiguration"
                                ],
                                "properties": {
                                    "dieConfiguration": {
                                        "enum": [
                                            "dual",
                                            "array"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "$comment": "An array of identical diodes described by one electrical block must state how many it holds (three or more).",
                    "if": {
                        "allOf": [
                            {
                                "required": [
                                    "part"
                                ],
                                "properties": {
                                    "part": {
                                        "required": [
                                            "dieConfiguration"
                                        ],
                                        "properties": {
                                            "dieConfiguration": {
                                                "const": "array"
                                            }
                                        }
                                    }
                                }
                            },
                            {
                                "required": [
                                    "electrical"
                                ]
                            }
                        ]
                    },
                    "then": {
                        "properties": {
                            "electrical": {
                                "required": [
                                    "numberOfElements"
                                ],
                                "properties": {
                                    "numberOfElements": {
                                        "minimum": 3
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "$comment": "A dual may state its count; it is then 2.",
                    "if": {
                        "required": [
                            "part"
                        ],
                        "properties": {
                            "part": {
                                "required": [
                                    "dieConfiguration"
                                ],
                                "properties": {
                                    "dieConfiguration": {
                                        "const": "dual"
                                    }
                                }
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "electrical": {
                                "properties": {
                                    "numberOfElements": {
                                        "const": 2
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "$comment": "A count of identical diodes is only meaningful on a package declared dual or array.",
                    "if": {
                        "required": [
                            "electrical"
                        ],
                        "properties": {
                            "electrical": {
                                "required": [
                                    "numberOfElements"
                                ]
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "part"
                        ],
                        "properties": {
                            "part": {
                                "required": [
                                    "dieConfiguration"
                                ],
                                "properties": {
                                    "dieConfiguration": {
                                        "enum": [
                                            "dual",
                                            "array"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "$comment": "dies[] length agrees with the declared configuration: a dual holds exactly two diodes, an array three or more.",
                    "if": {
                        "allOf": [
                            {
                                "required": [
                                    "part"
                                ],
                                "properties": {
                                    "part": {
                                        "required": [
                                            "dieConfiguration"
                                        ],
                                        "properties": {
                                            "dieConfiguration": {
                                                "const": "dual"
                                            }
                                        }
                                    }
                                }
                            },
                            {
                                "required": [
                                    "dies"
                                ]
                            }
                        ]
                    },
                    "then": {
                        "properties": {
                            "dies": {
                                "maxItems": 2
                            }
                        }
                    }
                },
                {
                    "if": {
                        "allOf": [
                            {
                                "required": [
                                    "part"
                                ],
                                "properties": {
                                    "part": {
                                        "required": [
                                            "dieConfiguration"
                                        ],
                                        "properties": {
                                            "dieConfiguration": {
                                                "const": "array"
                                            }
                                        }
                                    }
                                }
                            },
                            {
                                "required": [
                                    "dies"
                                ]
                            }
                        ]
                    },
                    "then": {
                        "properties": {
                            "dies": {
                                "minItems": 3
                            }
                        }
                    }
                }
            ],
            "oneOf": [
                {
                    "required": [
                        "electrical"
                    ],
                    "not": {
                        "required": [
                            "dies"
                        ]
                    }
                },
                {
                    "required": [
                        "dies"
                    ],
                    "not": {
                        "required": [
                            "electrical"
                        ]
                    }
                }
            ]
        },
        "die": {
            "title": "diodeDie",
            "description": "One diode inside a multi-diode package whose diodes differ, with the complete electrical block the discrete file already defines — the same physics and the same field names as a single-diode part, stated once per diode. Every diode states its own values even when the datasheet prints them as equal ('D1 = D2'), so 'both diodes are 0.4 V' and 'the part is 0.4 V' are different documents. 'Die' here is the SAS name for one device position (as in mosfet.json / bjt.json dies[]); it does not claim a separate silicon die — the elements of a monolithic array are entries too.",
            "unevaluatedProperties": false,
            "allOf": [
                {
                    "$ref": "./utils.json#/$defs/dieBase"
                },
                {
                    "type": "object",
                    "required": [
                        "subType",
                        "electrical"
                    ],
                    "properties": {
                        "subType": {
                            "description": "Diode type OF THIS DIODE. This is the field a mixed package needs and the single-diode shape cannot provide: a steering diode says switching and the clamp beside it says tvs, in one part. It selects the same required electrical fields as part.subType does for a single-diode part.",
                            "type": "string",
                            "enum": [
                                "rectifier",
                                "schottky",
                                "sicSchottky",
                                "fastRecovery",
                                "ultrafast",
                                "switching",
                                "pin",
                                "zener",
                                "tvs",
                                "esd"
                            ]
                        },
                        "electrical": {
                            "description": "The complete electrical block, per diode. numberOfElements is not legal here: one entry is one diode.",
                            "allOf": [
                                {
                                    "$ref": "#/$defs/electrical"
                                },
                                {
                                    "not": {
                                        "required": [
                                            "numberOfElements"
                                        ]
                                    }
                                }
                            ]
                        },
                        "thermal": {
                            "description": "Per-diode thermal figures where the datasheet gives them (junction-to-case, per-diode power dissipation). The package-level figure stays in datasheetInfo.thermal — one package, one R_th(j-a).",
                            "$ref": "./utils.json#/$defs/thermal"
                        }
                    }
                },
                {
                    "$comment": "Same subType-driven required sets as the package-level block (datasheetInfo.allOf), applied to this diode's own subType.",
                    "if": {
                        "properties": {
                            "subType": {
                                "const": "zener"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "electrical": {
                                "$ref": "#/$defs/zenerElectricalRequired"
                            }
                        }
                    },
                    "else": {
                        "if": {
                            "properties": {
                                "subType": {
                                    "const": "esd"
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "electrical": {
                                    "$ref": "#/$defs/esdElectricalRequired"
                                }
                            }
                        },
                        "else": {
                            "if": {
                                "properties": {
                                    "subType": {
                                        "const": "tvs"
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "electrical": {
                                        "$ref": "#/$defs/tvsElectricalRequired"
                                    }
                                }
                            },
                            "else": {
                                "properties": {
                                    "electrical": {
                                        "$ref": "#/$defs/rectifierElectricalRequired"
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "electrical": {
            "title": "diodeElectrical",
            "description": "Diode electrical characteristics. Required fields depend on part.subType (enforced in datasheetInfo): rectifier-family parts require reverseVoltage + forwardVoltage (V_F, the defining rectifier conduction parameter) + forwardCurrent; zener requires breakdownVoltage (= V_Z) + powerDissipation; esd requires standoffVoltage + at least one pulse rating (peakPulseCurrent, peakPulsePower or esdVoltageContact); tvs requires standoffVoltage + clampingVoltage + at least one pulse rating (peakPulseCurrent or peakPulsePower). TVS and ESD parts do not have a forwardCurrent (I_F(AV)) rating — that is a rectifier parameter; their forward-direction capability, when published, is the surge surgeCurrent (I_FSM). For a package declared part.dieConfiguration='dual' or 'array', every value here is PER DIODE (per leg / per line), never the package total, and numberOfElements states how many identical diodes the block describes. Each pulse rating carries its own waveform field; ratings at different waveforms are not comparable.",
            "type": "object",
            "additionalProperties": false,
            "dependentRequired": {
                "clampingCurrent": [
                    "clampingVoltage"
                ],
                "clampingWaveform": [
                    "clampingVoltage"
                ],
                "peakPulseCurrentWaveform": [
                    "peakPulseCurrent"
                ],
                "peakPulsePowerWaveform": [
                    "peakPulsePower"
                ]
            },
            "properties": {
                "numberOfElements": {
                    "description": "Number of IDENTICAL diodes in the package that this one electrical block describes; every other value in the block is per diode, never a package total. For an ESD / TVS array one element is one protected line (I/O channel) as the datasheet counts it ('8 lines'), whatever its internal steering/clamp structure. Required when part.dieConfiguration is 'array' (then >= 3); a 'dual' may state it and it is then 2; a single diode omits it. Taken from the datasheet, never inferred from the pin count. A package whose diodes differ has no electrical block and no count field: it is described in datasheetInfo.dies[], whose length is the count.",
                    "type": "integer",
                    "minimum": 2
                },
                "reverseVoltage": {
                    "type": "number",
                    "description": "V_RRM in Volts"
                },
                "forwardCurrent": {
                    "type": "number",
                    "description": "I_F(AV) in Amperes, per diode (per leg for dual packages)"
                },
                "surgeCurrent": {
                    "type": "number",
                    "description": "I_FSM in Amperes"
                },
                "forwardVoltage": {
                    "type": "number",
                    "description": "V_F in Volts"
                },
                "forwardVoltageAt": {
                    "type": "number",
                    "description": "I_F at which V_F is specified in Amperes"
                },
                "reverseLeakageCurrent": {
                    "type": "number",
                    "description": "I_R in Amperes"
                },
                "reverseRecoveryTime": {
                    "type": "number",
                    "description": "t_rr in seconds"
                },
                "reverseRecoveryCharge": {
                    "type": "number",
                    "description": "Q_rr in Coulombs"
                },
                "junctionCapacitance": {
                    "type": "number",
                    "description": "C_j in Farads"
                },
                "junctionCapacitanceVr": {
                    "type": "number",
                    "description": "V_R for C_j measurement in Volts"
                },
                "powerDissipation": {
                    "type": "number",
                    "description": "P_D max in Watts"
                },
                "clampingVoltage": {
                    "type": "number",
                    "description": "V_C for TVS/ESD in Volts, at clampingCurrent with clampingWaveform. Without clampingCurrent the record does not state the test current."
                },
                "clampingCurrent": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Peak test current at which clampingVoltage is specified, in Amperes (the datasheet's 'V_C @ I_PP' current, or e.g. 1 A). Same name and meaning as RAS varistor clampingCurrent."
                },
                "clampingWaveform": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/surgeWaveform",
                    "description": "Impulse at which clampingVoltage was measured. Absent = the record does not state it (no default)."
                },
                "breakdownVoltage": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/dimensionWithTolerance",
                    "description": "V_BR for Zener/TVS/ESD in Volts. For zeners this IS the zener voltage V_Z (min/nom/max from the datasheet table, specified at zenerTestCurrent) — there is deliberately no separate zenerVoltage field."
                },
                "zenerTestCurrent": {
                    "type": "number",
                    "description": "I_ZT in Amperes — test current at which V_Z (breakdownVoltage) is specified"
                },
                "zenerImpedance": {
                    "type": "number",
                    "description": "Z_ZT in Ohms — dynamic impedance at I_ZT"
                },
                "standoffVoltage": {
                    "type": "number",
                    "description": "V_RWM working voltage for TVS/ESD in Volts"
                },
                "polarity": {
                    "type": "string",
                    "enum": [
                        "unidirectional",
                        "bidirectional"
                    ],
                    "description": "Clamping direction of a TVS/ESD diode: 'unidirectional' clamps one polarity and conducts forward in the other; 'bidirectional' clamps both polarities symmetrically. Recorded only where the vendor's document states it for the part; never inferred from a part-number suffix. Absent = not stated (no default)."
                },
                "peakPulseCurrent": {
                    "type": "number",
                    "description": "I_PP (I_PPM) rating for TVS/ESD in Amperes, at peakPulseCurrentWaveform."
                },
                "peakPulseCurrentWaveform": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/surgeWaveform",
                    "description": "Impulse the peakPulseCurrent rating is stated at (e.g. '8/20' per IEC 61000-4-5). Absent = the record does not state it (no default)."
                },
                "peakPulsePower": {
                    "type": "number",
                    "description": "P_PP (P_PPM) rating for TVS/ESD in Watts, at peakPulsePowerWaveform."
                },
                "peakPulsePowerWaveform": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/surgeWaveform",
                    "description": "Impulse the peakPulsePower rating is stated at (classically '10/1000'). Absent = the record does not state it (no default)."
                },
                "esdVoltageContact": {
                    "type": "number",
                    "description": "IEC 61000-4-2 contact discharge rating in Volts"
                },
                "esdVoltageAir": {
                    "type": "number",
                    "description": "IEC 61000-4-2 air discharge rating in Volts"
                }
            }
        },
        "modelParams": {
            "title": "diodeModelParams",
            "description": "SPICE model parameters for diode.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "is": {
                    "type": "number",
                    "description": "Saturation current in Amperes"
                },
                "n": {
                    "type": "number",
                    "description": "Ideality factor"
                },
                "rs": {
                    "type": "number",
                    "description": "Series resistance in Ohms"
                },
                "cj0": {
                    "type": "number",
                    "description": "Zero-bias junction capacitance in Farads"
                },
                "vj": {
                    "type": "number",
                    "description": "Junction potential in Volts"
                },
                "m": {
                    "type": "number",
                    "description": "Grading coefficient"
                },
                "tt": {
                    "type": "number",
                    "description": "Transit time in seconds"
                },
                "bv": {
                    "type": "number",
                    "description": "Breakdown voltage in Volts"
                },
                "ibv": {
                    "type": "number",
                    "description": "Current at breakdown in Amperes"
                }
            }
        },
        "curves": {
            "title": "diodeCurves",
            "description": "Diode characteristic curves from datasheet.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "forwardVoltageVsCurrent": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/curve",
                    "description": "V_F vs I_F"
                },
                "forwardVoltageVsTj": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/curve",
                    "description": "V_F vs Tj"
                },
                "reverseCurrentVsVoltage": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/curve",
                    "description": "I_R vs V_R"
                },
                "capacitanceVsVoltage": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/curve",
