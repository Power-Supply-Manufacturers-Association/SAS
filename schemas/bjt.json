{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://psma.com/sas/bjt.json",
    "title": "bjt",
    "description": "BJT (npn or pnp) component data. The presence of the 'bjt' field at the top level of an SAS document discriminates the device type — there is no deviceType property.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "manufacturerInfo": {
            "title": "bjtManufacturerInfo",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/name"
                },
                "reference": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/reference"
                },
                "status": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/status"
                },
                "description": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/description"
                },
                "orderCode": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/orderCode"
                },
                "datasheetUrl": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/datasheetUrl"
                },
                "spiceModel": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/spiceModel"
                },
                "family": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo/properties/family"
                },
                "datasheetInfo": {
                    "$ref": "#/$defs/datasheetInfo"
                }
            },
            "required": [
                "name",
                "datasheetInfo"
            ]
        },
        "distributorsInfo": {
            "description": "Where to buy this component",
            "type": "array",
            "items": {
                "$ref": "https://psma.com/peas/utils.json#/$defs/distributorInfo"
            }
        }
    },
    "anyOf": [
        { "required": ["manufacturerInfo"] },
        { "maxProperties": 0 }
    ],
    "$defs": {
        "datasheetInfo": {
            "title": "bjtDatasheetInfo",
            "description": "All information extracted from the BJT datasheet.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "part": {
                    "$ref": "./utils.json#/$defs/part"
                },
                "electrical": {
                    "$ref": "#/$defs/electrical"
                },
                "thermal": {
                    "$ref": "./utils.json#/$defs/thermal"
                },
                "mechanical": {
                    "$ref": "./utils.json#/$defs/mechanical"
                }
            },
            "required": [
                "part",
                "electrical"
            ]
        },
        "electrical": {
            "title": "bjtElectrical",
            "description": "BJT electrical characteristics.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "collectorEmitterVoltage": {
                    "type": "number",
                    "description": "V_CEO in Volts"
                },
                "collectorBaseVoltage": {
                    "type": "number",
                    "description": "V_CBO in Volts"
                },
                "collectorCurrent": {
                    "type": "number",
                    "description": "I_C max in Amperes"
                },
                "dcCurrentGain": {
                    "$ref": "https://psma.com/peas/utils.json#/$defs/dimensionWithTolerance",
                    "description": "h_FE"
                },
                "saturationVoltage": {
                    "type": "number",
                    "description": "V_CE(sat) in Volts"
                },
                "transitionFrequency": {
                    "type": "number",
                    "description": "f_T in Hz"
                },
                "powerDissipation": {
                    "type": "number",
                    "description": "P_D max in Watts"
                }
            },
            "required": [
                "collectorEmitterVoltage",
                "collectorCurrent"
            ]
        }
    }
}
